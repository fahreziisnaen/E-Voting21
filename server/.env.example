# ── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Koneksi MySQL. Jika memakai `npm run db:up`, samakan password dengan DB_PASSWORD di .env root.
DATABASE_URL="mysql://evoting:evoting_dev_pw@127.0.0.1:3306/evoting"
# Database terpisah untuk `npm test` — AKAN DIKOSONGKAN setiap kali test jalan.
TEST_DATABASE_URL="mysql://evoting:evoting_dev_pw@127.0.0.1:3306/evoting_test"

# Rahasia JWT: string acak minimal 32 karakter, BERBEDA satu sama lain.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=ganti-dengan-string-acak-minimal-32-karakter-aaaa
JWT_REFRESH_SECRET=ganti-dengan-string-acak-minimal-32-karakter-bbbb
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=12

# Cookie `secure`: WAJIB true bila aplikasi diakses lewat HTTPS. Untuk uji coba via http di
# jaringan lokal (mis. http://192.168.x.x) set false — browser tidak menyimpan cookie Secure di http.
COOKIE_SECURE=false

# Isi jika server berada di belakang reverse proxy (nginx): jumlah hop, mis. 1.
TRUST_PROXY=false

# Folder penyimpanan foto upload (relatif terhadap folder server/).
UPLOAD_DIR=uploads

# ── Seeder (npm run db:seed) ─────────────────────────────────────────────
SEED_ADMIN_USERNAME=admin.osis
SEED_ADMIN_PASSWORD=ganti-kata-sandi-panitia
# Kode akses awal untuk seluruh siswa contoh. Ganti per siswa lewat panel panitia.
SEED_STUDENT_PASSWORD=osis2025
# true = buat suara contoh untuk sebagian siswa agar grafik panitia terisi.
SEED_DEMO_VOTES=true
