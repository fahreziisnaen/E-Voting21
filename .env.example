# Konfigurasi Docker Compose. Salin menjadi `.env` (satu folder dengan docker-compose.yml),
# lalu isi semua nilai yang kosong. Buat nilai acak dengan:  openssl rand -hex 32
# (gunakan hex agar aman dipakai di dalam URL koneksi database)

# Port host untuk aplikasi → http://<IP-server>:8021
APP_PORT=8021

DB_PASSWORD=
DB_ROOT_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# false = aplikasi diakses lewat http://IP:port (uji coba / jaringan lokal).
# true  = WAJIB bila diakses lewat HTTPS (mis. di belakang Caddy). Jangan pakai false untuk pemilihan sungguhan.
COOKIE_SECURE=false
# Isi 1 bila di belakang reverse proxy (Caddy/nginx) agar rate limit membaca IP asli siswa.
TRUST_PROXY=false

# Seeder berjalan saat container start HANYA jika database masih kosong.
SEED_ON_START=true
SEED_ADMIN_USERNAME=admin.osis
SEED_ADMIN_PASSWORD=
# Kode akses awal siswa contoh. Ganti per siswa lewat Panel Panitia.
SEED_STUDENT_PASSWORD=osis2025
# true = buat suara contoh agar grafik panitia terisi (hanya untuk demo).
SEED_DEMO_VOTES=false

# Hanya untuk docker-compose.dev.yml (pengembangan lokal).
DB_PORT=3306
